  effect(TEMP_DEF preval, TEMP tmp, TEMP tmp1, TEMP tmp2);
  format %{ "get_and_set_P_A $preval, $newval, [$mem], #@getAndSet_P_A_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->get_and_set_c2(this, masm,
                                                      as_Register($preval$$reg),
                                                      as_Register($newval$$reg),
                                                      as_Register($mem$$base),
                                                      as_Register($tmp$$reg),
                                                      as_Register($tmp1$$reg),
                                                      as_Register($tmp2$$reg),
                                                      /* acquire */ true);
  %}
  ins_pipe(pipe_slow);
%}

