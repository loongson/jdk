source %{
#include "gc/shenandoah/shenandoahBarrierSet.hpp"
#include "gc/shenandoah/shenandoahBarrierSetAssembler_loongarch.hpp"
%}

instruct load_P_shenandoah(mRegP dst, memory_loadRange mem, mRegP tmp1, mRegP tmp2)
%{
  match(Set dst (LoadP mem));
  predicate(UseShenandoahGC && n->as_Load()->barrier_data() != 0);
  effect(TEMP_DEF dst, TEMP tmp1, TEMP tmp2);
  // The main load is a candidate to implement implicit null checks.
  ins_is_late_expanded_null_check_candidate(true);
  format %{ "ld_d  $dst, $mem\t# ptr, shenandoah late-barrier, #@loadP_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->load_c2(this, masm, as_Register($dst$$reg), Address(as_Register($mem$$base), $mem$$disp), as_Register($tmp1$$reg), as_Register($tmp2$$reg), false);
  %}
  ins_cost(125);
  ins_pipe(ialu_load);
%}

instruct load_N_shenandoah(mRegN dst, memory_loadRange mem, mRegP tmp1, mRegP tmp2)
%{
  match(Set dst (LoadN mem));
  predicate(UseShenandoahGC && n->as_Load()->barrier_data() != 0);
  effect(TEMP_DEF dst, TEMP tmp1, TEMP tmp2);
  // The main load is a candidate to implement implicit null checks.
  ins_is_late_expanded_null_check_candidate(true);
  format %{ "ld_wu  $dst, $mem\t# compressed ptr, shenandoah late-barrier, #@loadN_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->load_c2(this, masm, as_Register($dst$$reg), Address(as_Register($mem$$base), $mem$$disp), as_Register($tmp1$$reg), as_Register($tmp2$$reg), true);
  %}
  ins_cost(125);
  ins_pipe(ialu_load);
%}

instruct storeP_shenandoah(mRegP src, memory_loadRange mem, mRegP tmp, mRegP tmp1, mRegP tmp2)
%{
  match(Set mem (StoreP mem src));
  predicate(UseShenandoahGC && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  effect(TEMP tmp, TEMP tmp1, TEMP tmp2);
  format %{ "st_d  $src, $mem\t# ptr, shenandoah late-barrier, #@storeP_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->store_c2(this, masm,
      Address(as_Register($mem$$base), $mem$$disp), /* dst_narrow = */ false,
      as_Register($src$$reg),                       /* src_narrow = */ false,
      as_Register($tmp$$reg),
      as_Register($tmp1$$reg),
      as_Register($tmp2$$reg));
  %}
  ins_cost(125);
  ins_pipe(ialu_store);
%}

instruct storeP_Volatile_shenandoah(mRegP src, indirect mem, mRegP tmp, mRegP tmp1, mRegP tmp2)
%{
  match(Set mem (StoreP mem src));
  predicate(UseShenandoahGC && needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  effect(TEMP tmp, TEMP tmp1, TEMP tmp2);
  format %{ "amswap_db_d  R0, $src, $mem\t# ptr, shenandoah late-barrier, #@storeP_Volatile_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->store_c2(this, masm,
      Address(as_Register($mem$$base)), /* dst_narrow = */ false,
      as_Register($src$$reg),           /* src_narrow = */ false,
      as_Register($tmp$$reg),
      as_Register($tmp1$$reg),
      as_Register($tmp2$$reg),
      true /* is_volatile */);
  %}
  ins_cost(125);
  ins_pipe(pipe_serial);
%}

