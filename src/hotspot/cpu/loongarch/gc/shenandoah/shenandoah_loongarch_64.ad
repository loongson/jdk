instruct encodePAndStoreN_shenandoah(mRegP src, memory_loadRange mem, mRegP tmp, mRegP tmp1, mRegP tmp2)
%{
  match(Set mem (StoreN mem (EncodeP src)));
  predicate(UseShenandoahGC && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  effect(TEMP tmp, TEMP tmp1, TEMP tmp2);
  format %{
    "encode_heap_oop $tmp, $src\n\t"
    "st_w  $tmp, $mem\t# compressed ptr, shenandoah late-barrier, #@encodePAndStoreN_shenandoah"
  %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->store_c2(this, masm,
        Address(as_Register($mem$$base), $mem$$disp), /* dst_narrow = */ true,
        as_Register($src$$reg),                       /* src_narrow = */ false,
        as_Register($tmp$$reg),
        as_Register($tmp1$$reg),
        as_Register($tmp2$$reg));
  %}
  ins_cost(125);
  ins_pipe(pipe_slow);
%}

instruct encodePAndStoreN_Volatile_shenandoah(mRegP src, indirect mem, mRegP tmp, mRegP tmp1, mRegP tmp2)
%{
