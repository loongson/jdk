instruct compareAndSwap_P_A_shenandoah(mRegI res, indirect mem, mRegP oldval, mRegP newval, mRegP tmp, mRegP tmp1, mRegP tmp2) %{
  match(Set res (CompareAndSwapP mem (Binary oldval newval)));
  predicate(UseShenandoahGC && needs_acquiring_load_reserved(n) && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP_DEF res, TEMP tmp, TEMP tmp1, TEMP tmp2);
  format %{ "cmpxchg_P_A_shenandoah $mem, $oldval, $newval\t# (ptr) if $mem == $oldval then $mem <-- $newval, #@compareAndSwap_P_A_shenandoah" %}
  ins_encode %{
    ShenandoahBarrierSet::assembler()->compare_and_set_c2(this, masm,
                                                          as_Register($res$$reg),
                                                          as_Register($mem$$base),
                                                          as_Register($oldval$$reg),
                                                          as_Register($newval$$reg),
                                                          as_Register($tmp$$reg),
                                                          as_Register($tmp1$$reg),
                                                          as_Register($tmp2$$reg),
                                                          /* exchange */ false,
                                                          /* is_narrow */ false,
                                                          /* weak */ false,
                                                          /* acquire */ true);
  %}
  ins_pipe(pipe_slow);
%}

